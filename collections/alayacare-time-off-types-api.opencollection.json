    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Time Off Types",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a list of time off types\n",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://example.alayacare.com/ext/api/v2/accounting/time_off_types",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Filter by page number."
              },
              {
                "name": "count",
                "value": "",
                "type": "query",
                "description": "Number of items per page."
              },
              {
                "name": "branch_id",
                "value": "",
                "type": "query",
                "description": "Filter by branch ID"
              },
              {
                "name": "pay_schedule_time",
                "value": "",
                "type": "query",
                "description": "Filter by time off type usable payable scheduled hours for payroll configuration"
              },
              {
                "name": "employee_role",
                "value": "",
                "type": "query",
                "description": "Filter by employee role, one or more using **OR**\nSee resource `roles` in `employee-api-external` for a list of available employee roles\nRefer to https://app.swaggerhub.com/apis/AlayaCare/employee-api-external for more information\n"
              },
              {
                "name": "employee_id",
                "value": "",
                "type": "query",
                "description": "Filter by AlayaCare Employee ID\n"
              },
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Substring search on time off type `name` and `service_code_name`"
              }
            ]
          },
          "docs": "Get a list of time off types\n"
        }
      ]
    }
  ],
  "bundled": true

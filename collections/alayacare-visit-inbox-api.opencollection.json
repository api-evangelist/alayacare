        },
        {
          "info": {
            "name": "POST /v1/inbox/visits/{visit_id}/hold",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://example.alayacare.com/ext/api/v2/accounting/v1/inbox/visits/:visit_id/hold",

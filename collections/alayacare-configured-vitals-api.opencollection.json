{
  "opencollection": "1.0.0",
  "info": {
    "name": "AlayaCare Accounting Accounts Configured Vitals API",
    "version": "1.0.19-oas3"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Configured Vitals",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a list of clients with vitals configured",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://example.alayacare.com/ext/api/v2/accounting/vitals/configured"
          },
          "docs": "Get a list of clients with vitals configured"
        }
      ]
    }
  ],
  "bundled": true
}
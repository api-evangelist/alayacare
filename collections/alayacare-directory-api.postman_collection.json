        {
          "id": "6cccd90b-8b23-4d00-98bb-2910a7304f7a",
          "name": "Copy or move a directory",
          "request": {
            "name": "Copy or move a directory",
            "description": {
              "content": "Copy or move a directory and create the underlying folder structure of the new location if it doesn't already exist.\n\nWhether the directory is moved or simply copied is defined by a `move` header that can be set to `true` (if the header is not provided, its value defaults to `false` and the `source` directory will remain).\n\nThe url of the `PUT` request is the path to the destination location.\ni.e., if we have the following directories:\n- `dir1/child1/`\n- `dir2/child2/`\n\nand we want to copy `child1/` inside `dir2/` (the goal is to have `dir2/child1/`), the `path` in the url of the `PUT` request has to be: `dir2/child1/`. The `source` header of the request has to be `dir1/child1/`.\n\nA 400 response will be returned for a request to move a folder in one of its own subfolders.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "client",
                ":id",
                ":path",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "",
                  "key": "id",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "",
                  "key": "path",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "path of the directory to copy or move (source directory)\n",
                "key": "source",
                "value": ""
              },
              {
                "disabled": false,
                "description": "specifies if the directory is moved or copied (defaults to false, i.e. copied)\n",
                "key": "move",
                "value": ""
              }
            ],
            "method": "PUT",
            "auth": null
          },
          "response": [
            {
              "id": "d981a503-3b7e-448f-a6b4-e9fea46abe75",

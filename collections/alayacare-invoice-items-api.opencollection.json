{
  "opencollection": "1.0.0",
  "info": {
    "name": "AlayaCare Accounting Accounts Invoice Items API",
    "version": "1.0.19-oas3"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Invoice Items",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fetch a specific invoice's invoice items",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://example.alayacare.com/ext/api/v2/accounting/billing/cycles/invoice/:invoice_id/details",
            "params": [
              {
                "name": "invoice_id",
                "value": "",
                "type": "path",
                "description": "Invoice ID"
              }
            ]
          },
          "docs": "Fetch a specific invoice's invoice items"
        },
        {
          "info": {
            "name": "Fetch multiple private pay invoices",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://example.alayacare.com/ext/api/v2/accounting/billing/periods/invoice/:invoice_id/details",
            "params": [
              {
                "name": "sort_order",
                "value": "",
                "type": "query",
                "description": "Order to sort by"
              },
              {
                "name": "invoice_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "sort_by",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Fetch multiple private pay invoices"
        }
      ]
    }
  ],
  "bundled": true
}
{
  "opencollection": "1.0.0",
  "info": {
    "name": "AlayaCare Accounting Accounts Service Forms API",
    "version": "1.0.19-oas3"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Service Forms",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get list of forms that can be attached to services",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://example.alayacare.com/ext/api/v2/accounting/services/forms",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Filter by the name of the form"
              },
              {
                "name": "branch_id",
                "value": "",
                "type": "query",
                "description": "Filter by the branch_id of the form"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Filter by page number."
              },
              {
                "name": "count",
                "value": "",
                "type": "query",
                "description": "Number of items per page."
              }
            ]
          },
          "docs": "Get a list of forms\n"
        }
      ]
    }
  ],
  "bundled": true
}
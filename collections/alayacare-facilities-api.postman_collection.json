        {
          "id": "af44e4a9-e61e-41f2-aede-bc4850c6adea",
          "name": "Get a list of facility visits",
          "request": {
            "name": "Get a list of facility visits",
            "description": {
              "content": "Returns visits where the client is a facility. For patient/client visits, use the `/visits` endpoint instead.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "facility_visits"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "description": {
                    "content": "Filter on a list of tags and return values for at least one matching tag. Filter by multiple tags using **OR**.\n",
                    "type": "text/plain"
                  },
                  "key": "tags",
                  "value": ""
                },
                {
                  "description": {
                    "content": "Filter by visit start time greater or equal than specified value.\nIf not specified will default to now.\nExpected format is ISO 8601.\nEx: `2018-02-03T08:00:00-05:00`\n",
                    "type": "text/plain"
                  },
                  "key": "start_at",
                  "value": ""
                },
                {
                  "description": {
                    "content": "Filter by visit start time less than or equal than specified value.\nIf not specified will default to 7 days from now.\nEx: `2018-02-18T08:00:00-05:00`\n",
                    "type": "text/plain"
                  },
                  "key": "end_at",
                  "value": ""
                },
                {
                  "description": {
                    "content": "Status of the visit based on status hierarchy from AlayaCare web application, one or more using **OR**. (This can only be one of scheduled,vacant,on_hold,cancelled,offered,clocked,late,completed,missed,approved)",
                    "type": "text/plain"
                  },
                  "key": "status",
                  "value": ""
                }
              ],
              "variable": []
            },
            "method": "GET",
            "auth": null
          },
          "response": [
            {

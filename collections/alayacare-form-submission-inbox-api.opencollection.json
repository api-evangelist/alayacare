            "url": "https://example.alayacare.com/ext/api/v2/accounting/v1/inbox/form_submissions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "# Authorization\nRequired role: supply `org_admin` assigned to the associated referral.\n\n# Description\nSave a form submission.\n\nOne of `service_id` or `visit_id` must be provided.\n"

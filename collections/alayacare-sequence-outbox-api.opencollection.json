{
  "opencollection": "1.0.0",
  "info": {
    "name": "AlayaCare Accounting Accounts sequence outbox API",
    "version": "1.0.19-oas3"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "sequence outbox",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /v1/outbox/sequences",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://example.alayacare.com/ext/api/v2/accounting/v1/outbox/sequences",
            "params": [
              {
                "name": "supply_persona_id",
                "value": "",
                "type": "query",
                "description": "Filter sequences by supply organization ID."
              },
              {
                "name": "client_outbox_id",
                "value": "",
                "type": "query",
                "description": "Filter sequences by client outbox ID."
              },
              {
                "name": "sequence_id",
                "value": "",
                "type": "query",
                "description": "Filter by specific sequence IDs."
              },
              {
                "name": "sort_by",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort_order",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "items_per_page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "# Authorization\nRequired role: `org_admin`\n\n# Description\nGet a paginated collection of sequences as a demand organization.\n"
        }
      ]
    }
  ],
  "bundled": true
}
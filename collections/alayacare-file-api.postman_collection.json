                  "type": "any",
                  "value": "",
                  "key": "id",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "",
                  "key": "path",
                  "description": "(Required) "
                }
              ]
            },
            "method": "PUT",
            "auth": null

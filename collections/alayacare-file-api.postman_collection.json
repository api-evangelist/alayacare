          "name": "Upload a file",
          "request": {
            "name": "Upload a file",
            "description": {
              "content": "Upload a file at the `path` location and create the underlying folder structure if it doesn't exist already.\n\n`path` **cannot** end with `/` in order to create a file based on the request body.\n\n**Note:** This consumes `multipart form-data` as defined in the parameters below.\n\n**Note on content attributes:** When specifying the key that references the file, the key must be set as `file` in the request in order for the API to find the file.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "client",
                ":id",
                ":path"
              ],
              "host": [

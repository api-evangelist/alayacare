                "description": "Filter by page number"
              },
              {
                "name": "count",
                "value": "",
                "type": "query",
                "description": "Number of items per page"
              }
            ]
          },
          "docs": "Get a list of premiums attached to a visit"
        },
        {
          "info": {
            "name": "Create a visit premium",
            "type": "http"
          },
          "http": {
            "method": "POST",
